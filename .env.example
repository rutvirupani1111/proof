# Everything is optional for local development: with no env at all, Proof runs on an
# in-process PGlite database under .data/ and generates + stores its own auth secret.

# Production database (Neon). When unset, PGlite (.data/pglite) is used.
# DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Optional. When unset, a 64-byte secret is generated once and stored in app_secrets.
# BETTER_AUTH_SECRET=

# Optional public origin (e.g. https://proof.vercel.app). Inferred from requests when unset.
# BETTER_AUTH_URL=http://localhost:5190

# Optional. Raises GitHub API rate limits for gist / repo verification.
# GITHUB_TOKEN=

# Optional. Stripe test-mode secret key; without it billing runs a labelled demo checkout.
# The webhook endpoint and its signing secret are created by the app (stored in app_secrets).
# STRIPE_SECRET_KEY=sk_test_...

# Optional. Real email (sign-up codes, password reset, magic links). Email counts as configured
# only when BOTH are set; otherwise codes and links are shown on screen in development / demo mode.
# EMAIL_FROM is the sender on a domain verified in Resend, e.g. "Name <noreply@your-domain>".
# RESEND_API_KEY=re_...
# EMAIL_FROM=
